# TODO: import the required dependencies
import pandas as pd

sql_query = """
WITH user_revenue AS (
    SELECT 
        u.country,
        s.user_id,
        SUM(p.amount_usd) AS total_revenue
    FROM payments p
    JOIN subscriptions s ON p.subscription_id = s.subscription_id
    JOIN users u ON s.user_id = u.user_id
    GROUP BY u.country, s.user_id
), 
country_avg_revenue AS (
    SELECT 
        country,
        AVG(total_revenue) AS avg_revenue_per_user
    FROM user_revenue
    GROUP BY country
)
SELECT country, avg_revenue_per_user
FROM country_avg_revenue
ORDER BY avg_revenue_per_user DESC
LIMIT 1;
"""

df = execute_sql_query(sql_query)

result = {"type": "dataframe", "value": df}
